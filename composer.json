{
    "name": "rafikidb/rafikidb",
    "description": "Typed PHP client for RafikiDB - data, auth, realtime, storage, env vars, secrets, webhooks, edge functions and payments.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "RafikiDB\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RafikiDB\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "keywords": [
        "rafikidb",
        "baas",
        "backend",
        "database",
        "realtime"
    ],
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "RafikiDB\\Laravel\\RafikiDBServiceProvider"
            ],
            "aliases": {
                "RafikiDB": "RafikiDB\\Facades\\RafikiDB"
            }
        }
    },
    "suggest": {
        "laravel/framework": "Required to use the service provider, facade and auth guard (auto-discovered).",
        "ext-sockets": "Required for the WebSocket realtime transport."
    }
}